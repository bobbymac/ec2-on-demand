# Copy this file to ec2ctl.conf and fill in the machine-specific values.
AWS_REGION=""
INSTANCE_ID=""
SSH_USER=""
TAILSCALE_HOST=""

# Adjust this allowlist for compatible types offered in the instance's AZ.
SUPPORTED_INSTANCE_TYPES=(
  t3.medium
  t3.large
  t3.xlarge
  t3.2xlarge
  m5.4xlarge
  m5.8xlarge
)

# Finite wait limits, in seconds.
START_TIMEOUT=600
SSM_TIMEOUT=600
PATCH_TIMEOUT=3600
REBOOT_TIMEOUT=900
STOP_TIMEOUT=600
FORCE_STOP_TIMEOUT=300
POLL_INTERVAL=10
